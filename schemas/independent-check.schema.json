{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/recrate/schemas/independent-check.schema.json",
  "title": "Independent check",
  "type": "object",
  "required": [
    "check",
    "about",
    "outcome",
    "summary",
    "method"
  ],
  "properties": {
    "check": {
      "type": "string",
      "pattern": "^I[0-9]+$"
    },
    "about": {
      "type": "string",
      "pattern": "^C[0-9]+$"
    },
    "outcome": {
      "enum": [
        "robust",
        "fragile",
        "contradicted"
      ]
    },
    "summary": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "results": {
      "type": "object"
    }
  }
}